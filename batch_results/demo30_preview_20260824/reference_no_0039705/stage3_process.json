        "bbox": [
          511.0,
          233.0,
          895.0,
          471.0
        ],
        "source_type": "text",
        "source_sentence": "The crude polymer thus obtained was represipitated twice using chloroform and methanol."
      },
      "confidence": {
        "score": 0.9
      }
    },
    {
