FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN sed -i 's|http://deb.debian.org|https://mirrors.cloud.tencent.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::ForceIPv4=true -o Acquire::Retries=3 install -y --no-install-recommends curl poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements-base.txt
COPY web_api/requirements.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir --retries 5 --timeout 60 \
    --index-url https://mirrors.cloud.tencent.com/pypi/simple \
    -r /tmp/requirements-base.txt -r /tmp/requirements-api.txt

COPY . .
RUN touch /app/.env \
    && mkdir -p /app/web_runtime/tasks /app/web_runtime/evidence_pages

EXPOSE 8000

CMD ["uvicorn", "web_api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
