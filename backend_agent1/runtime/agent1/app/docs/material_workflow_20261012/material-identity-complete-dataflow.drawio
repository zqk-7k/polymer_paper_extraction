Arrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="G2" target="UNKNOWN"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2190" y="1315"/><mxPoint x="2190" y="1545"/></Array></mxGeometry></mxCell><mxCell id="e34" value="继续迭代" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687773;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="G2" target="LOOP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2190" y="1315"/><mxPoint x="2190" y="1855"/></Array></mxGeometry></mxCell><mxCell id="e35" value="仍有缺口→AgentState" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687773;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="LOOP" target="D12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2220" y="1855"/><mxPoint x="2220" y="735"/></Array></mxGeometry></mxCell><mxCell id="e36" value="否：恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687773;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="G3" target="RECOVERY"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2580" y="1215"/><mxPoint x="2580" y="1915"/></Array></mxGeometry></mxCell><mxCell id="e37" value="最近检查点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687773;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="RECOVERY" target="D12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2210" y="1915"/><mxPoint x="2210" y="735"/></Array></mxGeometry></mxCell><mxCell id="e38" value="新增证据/修订建议" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#687773;strokeWidth=2;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="D20" target="D12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2920" y="1345"/><mxPoint x="2920" y="2220"/><mxPoint x="1480" y="2220"/><mxPoint x="1480" y="735"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;：实线 = 正式数据变化；虚线 = 来源回读 / Agent循环 / 恢复 / 专家反馈；菱形 = 是否满足进入下一阶段的材料条件。&lt;br&gt;&lt;b&gt;数据生命周期&lt;/b&gt;：原始文献 → 可回放来源 → 证据单元 → 材料出现/角色 → 组分与候选结构图 → 性质/命名 → 分层身份轮廓 → 验收报告 → 采用包 → 封存护照 → 材料身份库。&lt;br&gt;&lt;b&gt;持久化边界&lt;/b&gt;：项目根目录/config + data → 规则、运行配置、注册快照；同级 Polymer_Identity_App_Data → sources、解析中间物、runs、checkpoints、adopted、sealed、library。&lt;br&gt;实际代码对应：require_preflight = 运行前预检；run_job = 单篇材料文献完整抽取；READY_FOR_HOST_COMMIT = 已形成可交宿主的候选；Host save/adoption = 验收后采用；adoption recovery = 从检查点恢复。" style="text;html=1;strokeColor={LINE};fillColor={WHITE};align=left;verticalAlign=middle;fontColor={MUTED};fontFamily=Droid Sans Fallback;fontSize=14;spacing=8;" vertex="1" connectable="0" parent="1"><mxGeometry x="80" y="2170" width="3500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>