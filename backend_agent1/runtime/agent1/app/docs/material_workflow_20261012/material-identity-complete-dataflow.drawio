<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-10-12T14:00:00.000Z" agent="Mozilla/5.0" version="24.7.17" type="device"><diagram id="material-identity-complete-dataflow" name="完整数据流"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="1  文献来源与可回放解析" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#ffffff;strokeColor=#dce5df;fontColor=#ffffff;fontStyle=1;fontFamily=Droid Sans Fallback;fontSize=16;swimlaneFillColor=#18302d;" vertex="1" connectable="0" parent="1"><mxGeometry x="80" y="145" width="680" height="1990" as="geometry"/></mxCell><mxCell id="lane1" value="2  证据单元与材料对象归因" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#ffffff;strokeColor=#dce5df;fontColor=#ffffff;fontStyle=1;fontFamily=Droid Sans Fallback;fontSize=16;swimlaneFillColor=#18302d;" vertex="1" connectable="0" parent="1"><mxGeometry x="800" y="145" width="680" height="1990" as="geometry"/></mxCell><mxCell id="lane2" value="3  身份内核与 Agent 证据闭环" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#ffffff;strokeColor=#dce5df;fontColor=#ffffff;fontStyle=1;fontFamily=Droid Sans Fallback;fontSize=16;swimlaneFillColor=#18302d;" vertex="1" connectable="0" parent="1"><mxGeometry x="1520" y="145" width="680" height="1990" as="geometry"/></mxCell><mxCell id="lane3" value="4  宿主验收、采用与版本封存" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#ffffff;strokeColor=#dce5df;fontColor=#ffffff;fontStyle=1;fontFamily=Droid Sans Fallback;fontSize=16;swimlaneFillColor=#18302d;" vertex="1" connectable="0" parent="1"><mxGeometry x="2240" y="145" width="680" height="1990" as="geometry"/></mxCell><mxCell id="lane4" value="5  材料身份库与专家评审" style="swimlane;html=1;horizontal=1;startSize=34;fillColor=#ffffff;strokeColor=#dce5df;fontColor=#ffffff;fontStyle=1;fontFamily=Droid Sans Fallback;fontSize=16;swimlaneFillColor=#18302d;" vertex="1" connectable="0" parent="1"><mxGeometry x="2960" y="145" width="680" height="1990" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;完整数据流：材料身份从文献证据到可采用档案&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;每个节点都标出数据新增/变化；实线表示正式数据流，虚线表示回读、循环、恢复或专家反馈。&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=20;" vertex="1" connectable="0" parent="1"><mxGeometry x="80" y="25" width="3000" height="90" as="geometry"/></mxCell><mxCell id="D00" value="&lt;b&gt;D00  任务说明  JobSpec&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 文献路径 · 领域 · 运行ID&lt;br&gt;→ 形成一次可追踪任务&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="250" width="560" height="170" as="geometry"/></mxCell><mxCell id="D01" value="&lt;b&gt;D01  原始文献包  SourcePacket&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ PDF/补充材料 · 元数据 · 文件hash&lt;br&gt;→ 保留原始材料边界&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="470" width="560" height="170" as="geometry"/></mxCell><mxCell id="D02" value="&lt;b&gt;D02  运行前预检  Preflight&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 路径/权限/运行时/Kernel/规则版本&lt;br&gt;→ 通过才进入解析&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="690" width="560" height="170" as="geometry"/></mxCell><mxCell id="D03" value="&lt;b&gt;D03  来源清单  SourceManifest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ source_id · 页/图/表定位&lt;br&gt;+ 解析器版本 · 可回放索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="910" width="560" height="170" as="geometry"/></mxCell><mxCell id="D04" value="&lt;b&gt;D04  解析语料  ParsedCorpus&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;页面 → 文本块 · 图题 · 表格单元 · 坐标&lt;br&gt;+ MinerU/回退路径 · 版本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="1130" width="560" height="170" as="geometry"/></mxCell><mxCell id="G0" value="&lt;b&gt;G0  解析可回读？&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;主解析成功，且页图/文本可定位？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#18302d;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="1370" width="560" height="170" as="geometry"/></mxCell><mxCell id="FALLBACK" value="&lt;b&gt;回退来源  Fallback&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;解析失败 → PDF文本/原页图/人工回读&lt;br&gt;→ 仍生成可定位 EvidenceUnit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faf8;strokeColor=#687773;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="140" y="1620" width="560" height="170" as="geometry"/></mxCell><mxCell id="D05" value="&lt;b&gt;D05  证据单元  EvidenceUnit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ claim_type · 原文片段 · 页/图/表位置&lt;br&gt;+ 证据强度 · 原始引用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="260" width="560" height="170" as="geometry"/></mxCell><mxCell id="D06" value="&lt;b&gt;D06  材料出现  OccurrenceBundle&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;事实 → 样品/材料标签与作用域&lt;br&gt;+ 主链/共聚/接枝/端基/填料/添加剂角色&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="560" height="170" as="geometry"/></mxCell><mxCell id="GROLE" value="&lt;b&gt;G1  对象与角色明确？&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;样品、组分、工艺阶段可以区分？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#18302d;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="760" width="560" height="170" as="geometry"/></mxCell><mxCell id="D07" value="&lt;b&gt;D07  组分候选  ComponentSet&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 单体/CRU/片段 · 结构表示 · 来源&lt;br&gt;+ 连接端口 · 电荷 · 盐 · 立体/同位素&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="1030" width="560" height="170" as="geometry"/></mxCell><mxCell id="D08" value="&lt;b&gt;D08  候选结构图  CandidateGraph&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 组成/连接/架构边：嵌段·无规·接枝·交联&lt;br&gt;+ 多候选 · 冲突 · 未知；不强行合并&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="1270" width="560" height="170" as="geometry"/></mxCell><mxCell id="D09" value="&lt;b&gt;D09  性质与条件包  PropertyPackage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ Mw/Mn/Đ · Tg/Tm · 力学/热/光/电性质&lt;br&gt;+ 方法 · 单位 · 温度/时间 · 样品状态/作用域&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="1510" width="560" height="170" as="geometry"/></mxCell><mxCell id="D10" value="&lt;b&gt;D10  命名候选包  NameBundle&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 规则名 · IUPAC候选 · preferred name&lt;br&gt;+ catalog候选 · 规则条目 · 与结构图映射&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="860" y="1750" width="560" height="170" as="geometry"/></mxCell><mxCell id="D11" value="&lt;b&gt;D11  身份轮廓  IdentityProfile&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;L1 名称→实体；L2 实体→构成/CRU&lt;br&gt;L3 六元组+作用域；L4 审核；typed unknown(⊥)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1580" y="360" width="560" height="170" as="geometry"/></mxCell><mxCell id="D12" value="&lt;b&gt;D12  Agent 状态  AgentState&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 迭代号 · 当前假设 · 证据缺口 · 冲突队列&lt;br&gt;+ 待查页/图/表 · 已用工具 · 停止条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1580" y="650" width="560" height="170" as="geometry"/></mxCell><mxCell id="D13" value="&lt;b&gt;D13  工具结果  ToolResult&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;结构/命名/来源/图表核查的输入与输出&lt;br&gt;+ 工具版本 · 回执 · 结果挂接到证据/候选图&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1580" y="940" width="560" height="170" as="geometry"/></mxCell><mxCell id="G2" value="&lt;b&gt;G2  证据充分？&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;关键字段有证据？冲突已解释或显式保留？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#18302d;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="1230" width="560" height="170" as="geometry"/></mxCell><mxCell id="UNKNOWN" value="&lt;b&gt;待确认  UnknownQueue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;typed unknown(⊥) · 冲突候选 · 角色不明&lt;br&gt;保留缺口与来源，等待回读/人工确认&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faf8;strokeColor=#687773;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1580" y="1500" width="560" height="170" as="geometry"/></mxCell><mxCell id="LOOP" value="&lt;b&gt;Agent循环停止条件&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;无待查证据；关键字段有支撑；命名/结构检查通过&lt;br&gt;否则回到证据、图表或补充材料继续迭代&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faf8;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1580" y="1770" width="560" height="170" as="geometry"/></mxCell><mxCell id="D14" value="&lt;b&gt;D14  验收报告  ValidationReport&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;Kernel解析 · 结构/命名一致性 · 证据覆盖&lt;br&gt;+ 来源可追溯性 · 冲突/未知 · 警告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="2300" y="420" width="560" height="170" as="geometry"/></mxCell><mxCell id="D15" value="&lt;b&gt;D15  宿主候选包  HostCandidateBundle&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 身份轮廓 · 候选结构图 · 性质/命名&lt;br&gt;+ 证据索引 · 工具结果 · 可复核日志&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="2300" y="720" width="560" height="170" as="geometry"/></mxCell><mxCell id="G3" value="&lt;b&gt;G3  宿主验收通过？&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;schema、预算、版本、权限和采用合同通过？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#18302d;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2300" y="1030" width="560" height="170" as="geometry"/></mxCell><mxCell id="D16" value="&lt;b&gt;D16  采用包  AdoptedBundle&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 被选身份 · 作用域 · 版本 · 来源证据&lt;br&gt;→ 允许写入正式材料身份档案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="2300" y="1310" width="560" height="170" as="geometry"/></mxCell><mxCell id="D17" value="&lt;b&gt;D17  封存收据  Passport&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ run_id · source hash · session/model&lt;br&gt;+ Kernel/规则/工具哈希 · 输入输出清单&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="2300" y="1570" width="560" height="170" as="geometry"/></mxCell><mxCell id="RECOVERY" value="&lt;b&gt;恢复检查点  RecoveryCheckpoint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;+ 最近成功迭代 · EvidenceStore · CandidateGraph&lt;br&gt;+ 待办项/错误原因；失败不污染正式库&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faf8;strokeColor=#687773;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="2300" y="1830" width="560" height="170" as="geometry"/></mxCell><mxCell id="D19" value="&lt;b&gt;D19  材料身份库  IdentityLibrary&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;已采用身份、结构/名称/性质与证据链&lt;br&gt;+ 版本历史 · catalog映射 · 可检索索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="3020" y="870" width="560" height="170" as="geometry"/></mxCell><mxCell id="D20" value="&lt;b&gt;D20  材料专家评审&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;确认材料对象、结构关系、性质作用域和未知项&lt;br&gt;→ 补充证据或触发增量修订&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="3020" y="1180" width="560" height="170" as="geometry"/></mxCell><mxCell id="D21" value="&lt;b&gt;D21  可复用输出&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#687773&quot;&gt;材料身份档案 · 候选与证据 · 版本/回放入口&lt;br&gt;→ 支持后续检索、对比和数据扩展&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5f0;strokeColor=#196c59;strokeWidth=2;fontColor=#18302d;fontFamily=Droid Sans Fallback;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="3020" y="1500" width="560" height="170" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196c59;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="D00" target="D01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196c59;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="D01" target="D02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#196c59;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="D02" target="D03"><mxGeometry re